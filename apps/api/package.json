{
  "name": "@saiyan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Saiyan Ascend NestJS HTTP API",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "start:prod": "node --env-file=../../.env dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:self": "tsx --env-file=../../.env scripts/self-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.4.0",
    "@saiyan/contracts": "workspace:*",
    "@saiyan/database": "workspace:*",
    "@saiyan/domain": "workspace:*",
    "@saiyan/providers": "workspace:*",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.1",
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
