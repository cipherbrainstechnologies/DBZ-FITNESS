# Template only — NOT deployed. Wire this service in the Railway dashboard
# with Root Directory empty (monorepo root) and Config path = /apps/worker/railway.toml
# or set RAILWAY_DOCKERFILE_PATH=apps/worker/Dockerfile on the service.
# Keep this service private — no public HTTP domain.

[build]
builder = "DOCKERFILE"
dockerfilePath = "apps/worker/Dockerfile"
watchPatterns = [
  "apps/worker/**",
  "packages/database/**",
  "packages/domain/**",
  "pnpm-lock.yaml",
  "package.json",
]

[deploy]
startCommand = "node dist/main.js"
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
# No healthcheckPath — worker is not an HTTP service.
