# Local development placeholders — replace with your own values.
# Do not commit real secrets. Copy to `.env` at the monorepo root.

# --- Core runtime ---
APP_ENV=development
LOG_LEVEL=info
CONTENT_MODE=ORIGINAL
# CONTENT_MODE=DBZ_LICENSED  # presentation only; requires verified rights before publishing

# --- PostgreSQL (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://saiyan:saiyan@localhost:5432/saiyan_ascend?schema=public

# --- Redis (worker required; API optional until queue features) ---
REDIS_URL=redis://localhost:6379

# --- HTTP / CORS ---
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# --- Auth / session (generate strong random values locally; never commit real secrets) ---
# JWT_SECRET must be at least 32 characters for API validation.
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars
AUTH_ISSUER=saiyan-ascend
AUTH_AUDIENCE=saiyan-ascend-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Public client mirrors (no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_PROJECT_ID=

# --- Worker (requires DATABASE_URL + REDIS_URL) ---
HEARTBEAT_EVERY_MS=60000
# Poll interval for SIMULATED notification intent processing (not real push).
NOTIFICATION_POLL_EVERY_MS=30000
# Poll interval for fixture dry-run export/deletion jobs (never wipes DB).
PRIVACY_POLL_EVERY_MS=60000

# --- Optional / future providers (leave unset until configured; fixtures remain honest) ---
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=
# EMAIL_PROVIDER=
# EMAIL_FROM=
# EMAIL_API_KEY=
# PUSH_PROVIDER=
# EXPO_ACCESS_TOKEN=
# Coach: fixture by default. openai only if key configured; otherwise fixture still used.
COACH_PROVIDER=fixture
# COACH_PROVIDER=openai
# OPENAI_API_KEY=
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
# AI_DAILY_BUDGET=
# FOOD_DATA_PROVIDER=
# USDA_API_KEY=
